# Per-machine settings. Copy to .env and fill in; .env is gitignored.
# The Python entry points (bench, its COMET step, the manager API, worker, server) load it themselves;
# the Makefile reads it only for CUDA_HOME.
# Use absolute paths and no quotes: make reads this file too.

# The CUDA toolkit whose nvcc the Qwen3.5 translator's vLLM JIT-compiles with.
# An old /usr/bin/nvcc fails with "Unknown option '-generate-dependencies-with-compile'".
# Default: /usr/local/cuda
CUDA_HOME=/usr/local/cuda

# The datasets repo (git@github.com:STiTy-team/datasets.git) checkout.
# Required: every bench entry point (bench, COMET, manager API, worker) stops without it.
STITY_DATA_ROOT=/home/you/datasets

# Discord webhook that make bench posts its result or error to (bench/notify.py).
# Must point at a Forum channel — notify.py opens a thread per run and posts the
# metrics or error there, which only a Forum channel's webhook can do on its own.
# Discord: create a Forum channel > its settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Unset: no notification.
DISCORD_WEBHOOK_URL=

# The shared bucket that finished runs are uploaded to and config names are claimed in
# (bench/s3.py). Unset STITY_S3_BUCKET: runs stay on this machine and only local runs
# are checked for a config name changing meaning.
# Default prefix: stity/. Default host: this machine's hostname; it ends every run id.
STITY_S3_BUCKET=
STITY_S3_PREFIX=
STITY_HOST=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
