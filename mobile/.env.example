# WebSocket origin of the ASR server, without a path. The app appends /api/v1/ws.
# Required for preview and production builds. Development builds fall back to ws://localhost:8765
# and can switch servers in the app (Profile → Developer, or the QR code the server prints).
EXPO_PUBLIC_SERVER_URL=wss://example.proxy.runpod.net

# REST origin for accounts and records. Defaults to the WebSocket host over https.
# EXPO_PUBLIC_API_URL=https://example.proxy.runpod.net

# API areas answered by mock data: a comma list of capabilities, auth, profile, conversations,
# live — or "all" / "none". Default outside production: everything but live.
# Production builds refuse any mock.
# EXPO_PUBLIC_API_MOCKS=capabilities,auth,profile,conversations

# Bundle id and Android package. Production builds refuse the placeholder.
# APP_ID=com.example.stity
