[Unit]
Description=STiTy bench queue worker
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
Environment=PATH=@PATH@
EnvironmentFile=@CONFIG_DIR@/worker.env
RuntimeDirectory=stity-worker
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/install -m 400 -o @USER@ @CONFIG_DIR@/aws-credentials /run/stity-worker/aws
Environment=AWS_SHARED_CREDENTIALS_FILE=/run/stity-worker/aws
ExecStart=@UV@ run --project bench/worker python -m bench.worker
Restart=always
RestartSec=10
RestartPreventExitStatus=2
KillMode=control-group
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
